# Group Planning Assistant — every setting, documented (roadmap B-001).
# Copy to `.env` and fill in real values. `.env` is never committed.
# All settings use the GPA_ prefix (roadmap B-002).

# Environment name: dev | test | prod. In prod, the app refuses to
# start with the development secret key below.
GPA_ENV=dev

# Database URL. SQLite by default (WAL + synchronous=FULL are applied
# by the code, roadmap B-003); a PostgreSQL URL is the documented
# swap-point for later (roadmap D-06).
GPA_DATABASE_URL=sqlite:///./data/gpa.db

# Secret used to sign access tokens and hash one-time tokens.
# REQUIRED in prod — generate a long random value and keep it secret.
GPA_SECRET_KEY=dev-only-change-me

# Token lifetimes.
GPA_ACCESS_TOKEN_MINUTES=15
GPA_REFRESH_TOKEN_DAYS=30
GPA_MAGIC_LINK_MINUTES=30

# Where uploaded files live (content-addressed local store, B-007)
# and where the dev mail driver writes outgoing mail as files (B-012).
GPA_STORAGE_DIR=./data/storage
GPA_OUTBOX_DIR=./data/outbox

# Auth rate limit: attempts per minute per IP on auth routes (B-021).
GPA_AUTH_RATE_PER_MINUTE=30

# Background jobs: max attempts before a job is dead-lettered (B-008),
# and the base delay (seconds) for exponential backoff.
GPA_JOB_MAX_ATTEMPTS=5
GPA_JOB_BACKOFF_BASE_SECONDS=5

# Create tables automatically at startup (dev/demo convenience).
# In production, run Alembic migrations instead and set this to false.
GPA_AUTO_CREATE_TABLES=true
